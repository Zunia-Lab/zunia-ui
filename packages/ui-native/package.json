{
  "name": "@zunialab/ui-native",
  "version": "0.1.0",
  "description": "OPTIONAL React Native UI — not used by zunia-mobile (Flutter). Prefer packages/tokens-flutter.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react-native,react,react-native-web,@zunialab/tokens",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react-native,react,react-native-web,@zunialab/tokens",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.73.0"
  },
  "dependencies": {
    "@zunialab/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
