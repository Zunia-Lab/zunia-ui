{
  "name": "@zunialab/tokens",
  "version": "0.1.0",
  "description": "Zunia design tokens — colors, type, space. Shared by web, extension, and mobile.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zunia-Lab/zunia-ui.git"
  },
  "homepage": "https://github.com/Zunia-Lab/zunia-ui#readme",
  "bugs": {
    "url": "https://github.com/Zunia-Lab/zunia-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/native.ts --format esm --dts --clean && cp src/tokens.css dist/tokens.css && cp src/theme.css dist/theme.css",
    "dev": "tsup src/index.ts src/native.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:flutter": "tsx scripts/gen-flutter.ts",
    "check:contrast": "tsx scripts/check-contrast.ts"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
